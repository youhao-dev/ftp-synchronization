<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.you.ftpsynchronization.view.AddController" styleClass="dialog-root">
    <top>
        <VBox spacing="5" styleClass="dialog-header">
            <padding><Insets top="22" right="28" bottom="18" left="28"/></padding>
            <Label fx:id="dialogTitle" text="%dialog.addRule" styleClass="dialog-title"/>
            <Label fx:id="dialogDescription" text="%dialog.description" styleClass="dialog-subtitle"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll">
            <content>
                <VBox spacing="16" styleClass="dialog-content">
                    <padding><Insets top="18" right="26" bottom="18" left="26"/></padding>
                    <Label fx:id="ruleId" visible="false" managed="false"/>

                    <VBox spacing="14" styleClass="form-card">
                        <Label text="%section.basic" styleClass="form-section-title"/>
                        <VBox spacing="7">
                            <Label text="%field.ruleName" styleClass="form-label"/>
                            <TextField fx:id="name" promptText="%prompt.ruleName" styleClass="form-field"/>
                        </VBox>
                        <VBox spacing="7">
                            <Label text="%field.direction" styleClass="form-label"/>
                            <ComboBox fx:id="transferType" prefWidth="180" styleClass="form-combo"/>
                            <Label text="%hint.direction" wrapText="true" styleClass="field-hint"/>
                        </VBox>
                        <VBox spacing="7">
                            <Label text="%field.fileDescription" styleClass="form-label"/>
                            <TextField fx:id="filename" promptText="%prompt.description" styleClass="form-field"/>
                            <Label text="%hint.fileDescription" wrapText="true" styleClass="field-hint"/>
                        </VBox>
                        <VBox spacing="7">
                            <Label text="%field.localRootRequired" styleClass="form-label"/>
                            <HBox spacing="8">
                                <TextField fx:id="basePath" promptText="%prompt.localRoot" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="chooseBasePathButton" text="%button.chooseDirectory" onAction="#chooseBasePath" styleClass="button-secondary"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="7">
                            <Label text="%field.remoteRootRequired" styleClass="form-label"/>
                            <TextField fx:id="remoteBasePath" promptText="%prompt.remoteRoot" styleClass="form-field"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="13" styleClass="form-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="%section.dynamicPath" styleClass="form-section-title" HBox.hgrow="ALWAYS"/>
                            <Label text="%hint.casePadding" styleClass="hint-badge"/>
                        </HBox>
                        <VBox spacing="7">
                            <Label text="%field.rulePathRequired" styleClass="form-label"/>
                            <TextField fx:id="rulePath" promptText="%prompt.rulePath" styleClass="form-field"/>
                        </VBox>
                        <GridPane hgap="10" vgap="8" styleClass="token-grid">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.33"/>
                                <ColumnConstraints percentWidth="33.33"/>
                                <ColumnConstraints percentWidth="33.34"/>
                            </columnConstraints>
                            <VBox spacing="3" styleClass="token-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="%token.year" styleClass="token-title"/>
                                <Label text="{year} = 2026" styleClass="token-code"/>
                                <Label text="{YEAR} = 2026" styleClass="token-code"/>
                            </VBox>
                            <VBox spacing="3" styleClass="token-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="%token.month" styleClass="token-title"/>
                                <Label text="{month} = 8" styleClass="token-code"/>
                                <Label text="{MONTH} = 08" styleClass="token-code"/>
                            </VBox>
                            <VBox spacing="3" styleClass="token-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="%token.day" styleClass="token-title"/>
                                <Label text="{day} = 1" styleClass="token-code"/>
                                <Label text="{DAY} = 01" styleClass="token-code"/>
                            </VBox>
                            <VBox spacing="3" styleClass="token-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="%token.hour" styleClass="token-title"/>
                                <Label text="{hh} = 3" styleClass="token-code"/>
                                <Label text="{HH} = 03" styleClass="token-code"/>
                            </VBox>
                            <VBox spacing="3" styleClass="token-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="%token.minute" styleClass="token-title"/>
                                <Label text="{mm} = 5" styleClass="token-code"/>
                                <Label text="{MM} = 05" styleClass="token-code"/>
                            </VBox>
                            <VBox spacing="3" styleClass="token-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <Label text="%token.second" styleClass="token-title"/>
                                <Label text="{ss} = 9" styleClass="token-code"/>
                                <Label text="{SS} = 09" styleClass="token-code"/>
                            </VBox>
                        </GridPane>
                        <Label text="%help.rulePath" wrapText="true" styleClass="help-text"/>
                        <Label fx:id="legacyNotice" text="%legacy.notice" wrapText="true" visible="false" managed="false" styleClass="legacy-notice"/>
                        <CheckBox fx:id="legacyCompatibility" text="%legacy.checkbox" visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="12" styleClass="form-card">
                        <Label text="%section.offset" styleClass="form-section-title"/>
                        <GridPane hgap="14" vgap="7">
                            <columnConstraints><ColumnConstraints minWidth="180" prefWidth="220"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                            <Label text="%field.offsetRequired" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="delayTime" text="0" promptText="%prompt.offset" styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.rowSpan="2">
                                <Label text="%help.offset" wrapText="true" styleClass="help-text-strong"/>
                                <Label text="%help.offsetExamples" wrapText="true" styleClass="field-hint"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="12" styleClass="form-card">
                        <Label text="%section.latestCount" styleClass="form-section-title"/>
                        <GridPane hgap="14" vgap="7">
                            <columnConstraints><ColumnConstraints minWidth="180" prefWidth="220"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                            <Label text="%section.latestCount" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="latestFileCount" text="0" promptText="%prompt.count" styleClass="form-field" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.rowSpan="2">
                                <Label text="%help.latestCount" wrapText="true" styleClass="help-text-strong"/>
                                <Label text="%help.latestCompare" wrapText="true" styleClass="field-hint"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="10" styleClass="form-card">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="%section.preview" styleClass="form-section-title"/>
                                <Label text="%preview.hint" styleClass="field-hint"/>
                            </VBox>
                            <Label text="%preview.groups" styleClass="hint-badge"/>
                        </HBox>
                        <Label fx:id="previewNote" text="%preview.initial" wrapText="true" styleClass="preview-note"/>
                        <TableView fx:id="previewTable" prefHeight="176" minHeight="176" maxHeight="176" styleClass="preview-table">
                            <columns>
                                <TableColumn fx:id="previewTimeColumn" text="%column.dateTime" prefWidth="165"/>
                                <TableColumn fx:id="previewLocalColumn" text="%column.localPath" prefWidth="305"/>
                                <TableColumn fx:id="previewRemoteColumn" text="%column.ftpPath" prefWidth="305"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="dialog-footer">
            <padding><Insets top="13" right="26" bottom="16" left="26"/></padding>
            <Button text="%button.close" onAction="#close" styleClass="button-secondary"/>
            <Button fx:id="operate" text="%button.createRule" onAction="#save" styleClass="button-primary"/>
        </HBox>
    </bottom>
</BorderPane>
