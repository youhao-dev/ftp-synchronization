<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.you.ftpsynchronization.view.IndexController" styleClass="app-root">
    <left>
        <VBox prefWidth="210" minWidth="210" maxWidth="210" styleClass="sidebar">
            <padding><Insets top="22" right="14" bottom="16" left="14"/></padding>
            <VBox spacing="4" styleClass="brand-box">
                <Label text="%brand.title" styleClass="brand-title"/>
                <Label text="%brand.subtitle" styleClass="brand-subtitle"/>
            </VBox>
            <Label text="%nav.workspace" styleClass="nav-group-title"/>
            <Button fx:id="navRulesButton" text="%nav.rules" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showRulesPage" styleClass="nav-button"/>
            <Button fx:id="navSystemButton" text="%nav.systemLogs" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showSystemLogPage" styleClass="nav-button"/>
            <Button fx:id="navFtpButton" text="%nav.ftpLogs" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showFtpLogPage" styleClass="nav-button"/>
            <Label text="%nav.configuration" styleClass="nav-group-title"/>
            <Button fx:id="navSettingsButton" text="%nav.settings" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showSettingsPage" styleClass="nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="4" styleClass="sidebar-footer">
                <Label text="%label.javafxVersion" styleClass="sidebar-muted"/>
                <Label fx:id="versionLabel" text="dev" styleClass="sidebar-version"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="workspace">
            <VBox fx:id="rulesPage" spacing="18" styleClass="page">
                <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="%nav.rules" styleClass="page-title"/>
                        <Label text="%rules.subtitle" styleClass="page-subtitle"/>
                    </VBox>
                    <Label fx:id="runningBadge" text="%status.waiting" styleClass="status-badge,badge-idle"/>
                    <Button text="%button.runNow" onAction="#runNow" styleClass="button-secondary,toolbar-button"/>
                    <Button text="%button.addRule" onAction="#addItem" styleClass="button-primary,toolbar-button"/>
                </HBox>
                <HBox spacing="12">
                    <VBox spacing="5" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="%nav.rules" styleClass="stat-label"/>
                        <Label fx:id="ruleCountLabel" text="0" styleClass="stat-value"/>
                    </VBox>
                    <VBox spacing="5" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="%stats.frequency" styleClass="stat-label"/>
                        <Label fx:id="scheduleLabel" text="%schedule.initial" styleClass="stat-value-small"/>
                    </VBox>
                    <VBox spacing="5" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="%stats.lastCompleted" styleClass="stat-label"/>
                        <Label fx:id="lastRunLabel" text="%status.notRun" styleClass="stat-value-small"/>
                    </VBox>
                    <VBox spacing="5" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="%stats.pool" styleClass="stat-label"/>
                        <Label fx:id="poolStatusLabel" text="0 / 3" styleClass="stat-value-small"/>
                    </VBox>
                </HBox>
                <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="panel-card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="%section.ruleList" styleClass="section-title"/>
                            <Label text="%hint.doubleClick" styleClass="field-hint"/>
                        </VBox>
                        <Button text="%button.refresh" onAction="#flushed" styleClass="button-ghost"/>
                        <Button text="%button.clearAll" onAction="#clearRules" styleClass="button-danger-ghost"/>
                    </HBox>
                    <TableView fx:id="rulesTable" VBox.vgrow="ALWAYS" styleClass="rules-table">
                        <columns>
                            <TableColumn fx:id="nameColumn" text="%column.name" prefWidth="135"/>
                            <TableColumn fx:id="transferTypeColumn" text="%column.direction" prefWidth="68"/>
                            <TableColumn fx:id="filenameColumn" text="%column.description" prefWidth="120"/>
                            <TableColumn fx:id="basePathColumn" text="%column.localRoot" prefWidth="155"/>
                            <TableColumn fx:id="rulePathColumn" text="%column.rulePath" prefWidth="155"/>
                            <TableColumn fx:id="remoteBasePathColumn" text="%column.remoteRoot" prefWidth="160"/>
                            <TableColumn fx:id="delayTimeColumn" text="%column.offset" prefWidth="72"/>
                            <TableColumn fx:id="latestFileCountColumn" text="%column.fileCount" prefWidth="72"/>
                            <TableColumn fx:id="statusColumn" text="%column.status" prefWidth="82" sortable="false"/>
                            <TableColumn fx:id="actionColumn" text="%column.actions" prefWidth="180" sortable="false"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <VBox fx:id="systemLogPage" spacing="18" visible="false" managed="false" styleClass="page">
                <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="%nav.systemLogs" styleClass="page-title"/>
                        <Label text="%system.subtitle" styleClass="page-subtitle"/>
                    </VBox>
                    <Button text="%button.clearLogs" onAction="#clearSystemLogs" styleClass="button-secondary"/>
                </HBox>
                <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="panel-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="%system.latest" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Label text="%badge.liveMemory" styleClass="hint-badge"/>
                    </HBox>
                    <TableView fx:id="systemLogTable" VBox.vgrow="ALWAYS" styleClass="rules-table">
                        <columns>
                            <TableColumn fx:id="systemTimeColumn" text="%column.time" prefWidth="165"/>
                            <TableColumn fx:id="systemLevelColumn" text="%column.level" prefWidth="90"/>
                            <TableColumn fx:id="systemMessageColumn" text="%column.content" prefWidth="760"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <VBox fx:id="ftpLogPage" spacing="18" visible="false" managed="false" styleClass="page">
                <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="%nav.ftpLogs" styleClass="page-title"/>
                        <Label text="%ftp.subtitle" styleClass="page-subtitle"/>
                    </VBox>
                    <Button text="%button.clearLogs" onAction="#clearFtpLogs" styleClass="button-secondary"/>
                </HBox>
                <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="panel-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="%ftp.details" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                        <Label text="%badge.live200" styleClass="hint-badge"/>
                    </HBox>
                    <TableView fx:id="ftpLogTable" VBox.vgrow="ALWAYS" styleClass="rules-table">
                        <columns>
                            <TableColumn fx:id="ftpTimeColumn" text="%column.time" prefWidth="158"/>
                            <TableColumn fx:id="ftpRuleColumn" text="%column.rule" prefWidth="125"/>
                            <TableColumn fx:id="ftpFileColumn" text="%column.file" prefWidth="165"/>
                            <TableColumn fx:id="ftpStatusColumn" text="%column.status" prefWidth="80"/>
                            <TableColumn fx:id="ftpSizeColumn" text="%column.size" prefWidth="85"/>
                            <TableColumn fx:id="ftpDurationColumn" text="%column.duration" prefWidth="82"/>
                            <TableColumn fx:id="ftpRemoteColumn" text="%column.serverPath" prefWidth="260"/>
                            <TableColumn fx:id="ftpMessageColumn" text="%column.message" prefWidth="250"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <VBox fx:id="settingsPage" spacing="18" visible="false" managed="false" styleClass="page">
                <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>
                <VBox spacing="4">
                    <Label text="%nav.settings" styleClass="page-title"/>
                    <Label text="%settings.subtitle" styleClass="page-subtitle"/>
                </VBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="settings-scroll">
                    <content>
                        <VBox spacing="14">
                            <VBox spacing="8" styleClass="settings-card">
                                <Label text="%settings.language" styleClass="section-title"/>
                                <ComboBox fx:id="languageCombo" prefWidth="230" styleClass="form-combo"/>
                                <Label text="%settings.languageHint" styleClass="field-hint"/>
                            </VBox>
                            <VBox spacing="13" styleClass="settings-card">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="%settings.ftpServer" styleClass="section-title"/>
                                        <Label text="%settings.keys" styleClass="field-hint"/>
                                    </VBox>
                                    <Button fx:id="testConnectionButton" text="%button.testConnection" onAction="#testConnection" styleClass="button-secondary"/>
                                </HBox>
                                <GridPane hgap="12" vgap="10">
                                    <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="%field.ftpHost" styleClass="form-label"/>
                                        <TextField fx:id="ftpHostField" promptText="%prompt.ftpHost" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="%field.ftpPort" styleClass="form-label"/>
                                        <TextField fx:id="ftpPortField" promptText="21" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="%field.username" styleClass="form-label"/>
                                        <TextField fx:id="ftpUsernameField" promptText="username" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="%field.password" styleClass="form-label"/>
                                        <PasswordField fx:id="ftpPasswordField" promptText="password" styleClass="form-field"/>
                                    </VBox>
                                </GridPane>
                                <Label text="%settings.security" wrapText="true" styleClass="field-hint"/>
                            </VBox>

                            <VBox spacing="13" styleClass="settings-card">
                                <VBox spacing="3">
                                    <Label text="%settings.poolTitle" styleClass="section-title"/>
                                    <Label text="%settings.poolHint" styleClass="field-hint"/>
                                </VBox>
                                <GridPane hgap="12" vgap="10">
                                    <columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints>
                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="%field.poolSize" styleClass="form-label"/>
                                        <TextField fx:id="poolSizeField" promptText="3" styleClass="form-field"/>
                                        <Label text="%hint.poolSize" styleClass="field-hint"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="%field.poolWait" styleClass="form-label"/>
                                        <TextField fx:id="poolBorrowTimeoutField" promptText="10000" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                        <Label text="%field.connectTimeout" styleClass="form-label"/>
                                        <TextField fx:id="connectTimeoutField" promptText="10000" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="%field.readTimeout" styleClass="form-label"/>
                                        <TextField fx:id="readTimeoutField" promptText="30000" styleClass="form-field"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="%field.dataTimeout" styleClass="form-label"/>
                                        <TextField fx:id="dataTimeoutField" promptText="30000" styleClass="form-field"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <VBox spacing="13" styleClass="settings-card">
                                <VBox spacing="3">
                                    <Label text="%settings.scheduleTitle" styleClass="section-title"/>
                                    <Label text="%settings.scheduleHint" styleClass="field-hint"/>
                                </VBox>
                                <GridPane hgap="12" vgap="10">
                                    <columnConstraints><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/></columnConstraints>
                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="%stats.frequency" styleClass="form-label"/>
                                        <HBox spacing="7">
                                            <TextField fx:id="frequencyValueField" promptText="1" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                                            <ComboBox fx:id="frequencyUnitCombo" prefWidth="92" styleClass="form-combo"/>
                                        </HBox>
                                        <Label text="%hint.frequency" styleClass="field-hint"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="%field.defaultCount" styleClass="form-label"/>
                                        <TextField fx:id="latestFileCountField" promptText="5" styleClass="form-field"/>
                                        <Label text="%hint.defaultCount" styleClass="field-hint"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                        <Label text="%field.stableSeconds" styleClass="form-label"/>
                                        <TextField fx:id="fileStableSecondsField" promptText="3" styleClass="form-field"/>
                                        <Label text="%hint.stableSeconds" styleClass="field-hint"/>
                                    </VBox>
                                    <VBox spacing="6" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                        <Label text="%field.alignSecond" styleClass="form-label"/>
                                        <TextField fx:id="scheduleSecondField" promptText="58" styleClass="form-field"/>
                                        <Label text="%hint.alignSecond" styleClass="field-hint"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <VBox spacing="8" styleClass="settings-card">
                                <Label text="%settings.persistence" styleClass="section-title"/>
                                <Label text="%settings.persistenceHint" wrapText="true" styleClass="field-hint"/>
                                <Label fx:id="settingsFileLabel" text="ftp-synchronization-settings.properties" wrapText="true" styleClass="code-path"/>
                            </VBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Label fx:id="settingsStatusLabel" text="%settings.saveHint" HBox.hgrow="ALWAYS" styleClass="settings-status"/>
                                <Button text="%button.saveSettings" onAction="#saveSettings" styleClass="button-primary,toolbar-button"/>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="9" styleClass="status-bar">
            <padding><Insets top="9" right="20" bottom="9" left="20"/></padding>
            <Label text="●" styleClass="status-dot"/>
            <Label fx:id="statusLabel" text="%status.ready" styleClass="status-text" HBox.hgrow="ALWAYS"/>
            <Label text="%status.footer" styleClass="status-hint"/>
        </HBox>
    </bottom>
</BorderPane>
