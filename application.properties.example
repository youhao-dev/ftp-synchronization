# 默认配置。程序会继续兼容工作目录中的 application.properties/application.yml。
# 在界面“FTP 与运行设置”保存后，会生成 ftp-synchronization-settings.properties，并以该文件为最高优先级。
ui.language=auto
ftp.host=127.0.0.1
ftp.port=21
ftp.username=anonymous
ftp.password=

# FTP 超时与连接池
ftp.connect-timeout-ms=10000
ftp.read-timeout-ms=30000
ftp.data-timeout-ms=30000
ftp.pool-size=3
ftp.pool-borrow-timeout-ms=10000

# 上传任务
upload.interval-seconds=60
# 兼容 cron：当频率正好为 60 秒时，首次执行对齐到每分钟第 58 秒
upload.schedule-second=58
upload.latest-file-count=5
upload.file-stable-seconds=3
